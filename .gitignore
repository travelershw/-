desktop/pet_data.db
desktop/chat_log.jsonl
desktop/pet_log.txt
desktop/shots/
desktop/assets/
desktop/_build/
desktop/_dist/
# 传感器运行数据：本机状态读数与天气缓存（含你填的位置），只在本机，绝不进仓库
desktop/pc_state.json
desktop/weather.json
# 语音：录音片段与模型文件（模型是 78 MB 二进制，由使用者自己下载）
desktop/clips/
desktop/models/
*.spec

